TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
SEC_IDENTITY_EMAIL=you@example.com
# Leave WHALE_CIKS empty to track the curated list of famous whales in app/whales.py
WHALE_CIKS=
DATABASE_PATH=whale_alert.db
# 13F polling interval (quarterly data)
POLL_INTERVAL_MINUTES=60
# Form 4 (insider trades) polling interval in minutes
INSIDER_POLL_INTERVAL_MINUTES=360
# Weekly digest schedule (cron day-of-week and hour, server local time)
WEEKLY_REPORT_DAY=mon
WEEKLY_REPORT_HOUR=9
# Enable the interactive Telegram command bot (long polling)
ENABLE_BOT=true
